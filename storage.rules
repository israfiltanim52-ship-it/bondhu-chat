rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /voice/{chatId}/{userId}/{fileName} {
      // Uploads and playback are limited to members of the matching chat.
      allow read: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
  }
}